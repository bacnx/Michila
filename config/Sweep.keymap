#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 900

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>;
};

&mt {
    tapping-term-ms = <300>;
    flavor = "tap-preferred";
};

&lt { tapping-term-ms = <300>; };

/ {
    behaviors {
        // Balanced hold-tap with prior-idle to prevent false mod triggers while typing
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // Precision mouse: slow ramp, linear, lower event rate
        mmv_slow: mmv_slow {
            compatible = "zmk,behavior-input-two-axis";
            label = "MMV_SLOW";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <2000>;
            acceleration-exponent = <0>;
            trigger-period-ms = <32>;
        };

        // Fast mouse: quick ramp, exponential, high event rate
        mmv_fast: mmv_fast {
            compatible = "zmk,behavior-input-two-axis";
            label = "MMV_FAST";
            #binding-cells = <1>;
            x-input-code = <INPUT_REL_X>;
            y-input-code = <INPUT_REL_Y>;
            time-to-max-speed-ms = <100>;
            acceleration-exponent = <2>;
            trigger-period-ms = <8>;
        };

        Scroll_D_U: Scroll_D_U {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_D_U";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        Scroll_U_D: Scroll_U_D {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_U_D";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };

        Scroll_LR: Scroll_LR {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_LR";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
            tap-ms = <20>;
        };

        Scroll_RL: Scroll_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCROLL_RL";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <20>;
        };

        mouse_DU: mouse_DU {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_DU";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_DOWN>, <&mmv MOVE_UP>;
        };

        mouse_RL: mouse_RL {
            compatible = "zmk,behavior-sensor-rotate";
            label = "MOUSE_RL";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Both inner thumbs together → toggle media layer
        combo_media {
            bindings = <&tog 3>;
            key-positions = <31 32>;
            timeout-ms = <50>;
        };

        // N+E → ESC (positions 16+17, right index+middle home row)
        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <16 17>;
            timeout-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ─── Layer 0: Colemak-DH + Home Row Mods ───────────────────────
        // G=GUI  A=ALT  C=CTRL  S=SHIFT  (mirrored left/right)
        default_layer {
            display-name = "Colemak-DH";
            bindings = <
&kp Q         &kp W         &kp F          &kp P          &kp B      &kp J       &kp L          &kp U          &kp Y         &kp SEMI
&hm LGUI A    &hm LALT R    &hm LCTRL S    &hm LSHFT T    &kp G      &kp M       &hm RSHFT N    &hm RCTRL E    &hm RALT I    &hm RGUI O
&kp Z         &kp X         &kp C          &kp D          &kp V      &kp K       &kp H          &kp COMMA      &kp DOT       &kp FSLH
                                            &kp SPACE      &lt 1 BSPC &lt 2 TAB   &kp ENTER
            >;
            sensor-bindings = <&Scroll_D_U>, <&Scroll_RL>;
        };

        // ─── Layer 1: Numbers & Symbols ─────────────────────────────
        // Hold L-inner (BSPC key). R-inner → to 4 (mouse)
        lower_layer {
            display-name = "Num/Sym";
            bindings = <
&kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT    &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR
&kp N1      &kp N2      &kp N3      &kp N4      &kp N5       &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
&kp GRAVE   &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT     &kp BSLH    &kp SQT     &kp SEMI    &kp UNDER   &kp PIPE
                                     &kp SPACE   &trans       &to 4       &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP>, <&inc_dec_kp RIGHT LEFT>;
        };

        // ─── Layer 2: Navigation ────────────────────────────────────
        // Hold R-inner (TAB key). N/E/I/O = LEFT/DOWN/UP/RIGHT
        // L-inner → to 4 (mouse)
        raise_layer {
            display-name = "Nav";
            bindings = <
&kp ESC     &kp INS     &trans      &kp PSCRN   &trans       &trans      &kp PGUP    &kp DEL     &trans      &trans
&kp CAPS    &trans      &trans      &trans      &trans       &kp HOME    &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT
&trans      &kp LC(Z)   &kp LC(X)   &kp LC(C)   &kp LC(V)    &kp END     &kp PGDN    &trans      &trans      &trans
                                     &kp SPACE   &to 4        &trans      &kp ENTER
            >;
            sensor-bindings = <&inc_dec_kp DOWN UP>, <&inc_dec_kp RIGHT LEFT>;
        };

        // ─── Layer 3: Media & Brightness ────────────────────────────
        // Toggled by combo (both inner thumbs). Exit via R-outer.
        media_layer {
            display-name = "Media";
            bindings = <
&trans          &trans          &trans          &trans          &trans    &trans  &trans  &trans  &trans  &trans
&kp C_MUTE      &kp C_VOL_DN    &kp C_VOL_UP    &kp C_BRI_DN    &kp C_BRI_UP    &trans  &trans  &trans  &trans  &trans
&kp C_PREV      &kp C_PP        &kp C_NEXT      &trans          &trans    &trans  &trans  &trans  &trans  &trans
                                                 &trans          &trans    &trans  &to 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>, <&inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        // ─── Layer 4: Mouse ───────────────────────────────────────────
        // Right hand  — N/E/I/O = MOVE_LEFT/DOWN/UP/RIGHT (normal speed)
        // Left body   — T=LCLK  G=RCLK  D=MCLK
        //               A=mo(5) slow    S=mo(6) fast
        //               R=MB4(back)     V=MB5(fwd)
        //               Q/W/F/P = scroll left/down/up/right
        // All thumbs  — to 0 (exit mouse layer)
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &trans          &trans  &trans           &trans           &trans          &trans
&mo 5           &mkp MB4        &mo 6           &mkp LCLK       &mkp RCLK       &trans  &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP    &mmv MOVE_RIGHT
&trans          &trans          &trans          &mkp MCLK       &mkp MB5        &trans  &trans           &trans           &trans          &trans
                                                &to 0           &to 0           &to 0   &to 0
            >;
            sensor-bindings = <&mouse_DU>, <&mouse_RL>;
        };

        // ─── Layer 5: Slow mouse overlay ────────────────────────────
        // Active while holding A in mouse layer. Only NEIO overridden.
        slow_mouse {
            display-name = "Slow";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                  &trans                  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mmv_slow MOVE_LEFT     &mmv_slow MOVE_DOWN     &mmv_slow MOVE_UP       &mmv_slow MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                  &trans                  &trans
                         &trans  &trans   &trans  &trans
            >;
            sensor-bindings = <&mouse_DU>, <&mouse_RL>;
        };

        // ─── Layer 6: Fast mouse overlay ────────────────────────────
        // Active while holding S in mouse layer. Only NEIO overridden.
        fast_mouse {
            display-name = "Fast";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                  &trans                  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &mmv_fast MOVE_LEFT     &mmv_fast MOVE_DOWN     &mmv_fast MOVE_UP       &mmv_fast MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans    &trans  &trans                  &trans                  &trans                  &trans
                         &trans  &trans   &trans  &trans
            >;
            sensor-bindings = <&mouse_DU>, <&mouse_RL>;
        };
    };
};
